# 妙云AI 生产部署 —— 环境变量
#
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会入库。
#   cp .env.example .env && vi .env

# PostgreSQL —— new-api 的主数据库
POSTGRES_USER=root
POSTGRES_PASSWORD=请填写强随机密码
POSTGRES_DB=new-api

# Redis —— 缓存与限流；密码同时用于 redis --requirepass
REDIS_PASSWORD=请填写强随机密码

# 会话签名密钥 —— 泄露会导致会话可被伪造，请使用足够长度的随机串
# 生成示例: openssl rand -hex 32
SESSION_SECRET=请填写至少32字节的随机串

# 可选：容器时区与节点名（不填则用 compose 中的默认值）
# TZ=Asia/Shanghai
# NODE_NAME=opc-new-api-vps
